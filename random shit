    BIN_DIR="$PREFIX/bin"
else
    BIN_DIR="$HOME/.local/bin"
    mkdir -p "$BIN_DIR"
fi

# 2. Ссылка на твой репозиторий (ЗАМЕНИ НА СВОЮ!)
REPO_URL="https://raw.githubusercontent.com/ТВОЙ_НИК/ТВОЙ_РЕПОЗИТОРИЙ/main"

# 3. Список скриптов, которые нужно скачать
