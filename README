idk why you need it but here the script

#!/bin/bash

# Цвета для красоты
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}=== Installation of Maxwell's Scripts ===${NC}"

# 1. Определяем папку bin (для Termux это $PREFIX/bin, для Linux ~/.local/bin)
if [ -n "$PREFIX" ]; then
    BIN_DIR="$PREFIX/bin"
else
    BIN_DIR="$HOME/.local/bin"
    mkdir -p "$BIN_DIR"
fi

# 2. Ссылка на твой репозиторий (ЗАМЕНИ НА СВОЮ!)
REPO_URL="https://raw.githubusercontent.com/ТВОЙ_НИК/ТВОЙ_РЕПОЗИТОРИЙ/main"

# 3. Список скриптов, которые нужно скачать
SCRIPTS=("todm" "teub")

echo -e "${YELLOW}Downloading scripts to $BIN_DIR...${NC}"

cd "$BIN_DIR" || exit 1

for script in "${SCRIPTS[@]}"; do
    echo -n "  -> Installing $script... "
    # Скачиваем файл с GitHub
    curl -sL "$REPO_URL/$script" -o "$script"
    
    # Делаем его исполняемым
    chmod +x "$script"
    
    if [ -f "$script" ]; then
        echo -e "${GREEN}[OK]${NC}"
    else
        echo -e "\033[0;31m[FAILED]${NC}"
    fi
done

# 4. Возвращаемся в домашнюю папку (как ты просил "просто пишет cd")
cd ~

# 5. Выводим финальное сообщение и список команд
echo -e "\n${GREEN}todm/teub has been installed!${NC}"
echo -e "${CYAN}This is the list of commands you need to remember:${NC}"
echo "-----------------------------------------------"
echo -e " ${YELLOW}todm${NC}  - Termux Only Display Manager"
echo -e " ${YELLOW}teub${NC}  - GRUB but for Termux"
echo "-----------------------------------------------"
